---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Find Wen Bin on LinkedIn.">
  <section aria-labelledby="contact-title">
    <h1 id="contact-title" class="mb-2">Contact</h1>
    <p class="mb-5 text-base leading-[1.55] text-black">
      You can connect with me on <a
        rel="me noopener noreferrer"
        target="_blank"
        href="https://www.linkedin.com/in/ngwenbin/">LinkedIn</a
      >.
    </p>
  </section>
</BaseLayout>
