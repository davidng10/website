---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const thoughts = (
  await getCollection("thoughts", ({ data }) => !data.draft)
).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const dateFormat = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<BaseLayout
  title="Thoughts"
  description="Occasional notes by Wen Bin about software and engineering."
  flush
>
  <section aria-labelledby="posts-title">
    <h1 id="posts-title" class="sr-only">Thoughts</h1>
    <ol class="m-0 list-none p-0">
      {
        thoughts.map((post) => (
          <li class="grid-full-rule">
            <article class="px-6 py-8 sm:px-12 md:px-16">
              <h2 class="mb-1">
                <a href={`/thoughts/${post.id}/`}>{post.data.title}</a>
              </h2>
              <time
                class="block text-[0.8125rem] text-[#68717d]"
                datetime={post.data.published.toISOString()}
              >
                {dateFormat.format(post.data.published)}
              </time>
              <p class="mb-0 mt-3 max-w-2xl text-base leading-[1.55] text-[#202938]">
                {post.data.description}
              </p>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
