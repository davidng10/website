---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { AUTHOR } from "../../data/author";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("thoughts", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"thoughts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.published);

const postUrl = `/thoughts/${post.id}/`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  url: postUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  author: AUTHOR,
};
---

<BaseLayout
  title={`${post.data.title}`}
  description={post.data.description}
  structuredData={structuredData}
>
  <article>
    <header class="mb-8 border-b border-[#e3e5e8] pb-7">
      <time
        class="mb-2 block text-[0.8125rem] text-[#68717d]"
        datetime={post.data.published.toISOString()}
      >
        {published}
      </time>
      <h1 class="mb-3">
        {post.data.title}
      </h1>
      <p class="m-0 max-w-2xl leading-[1.55] text-[#4f5966]">
        {post.data.description}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
