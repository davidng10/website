---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("thoughts", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"thoughts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.published);
---

<BaseLayout title={`${post.data.title}`} description={post.data.description}>
  <article>
    <header class="mb-8 border-b border-[#e3e5e8] pb-7">
      <h1 class="mb-3">
        {post.data.title}
      </h1>
      <div class="flex gap-2 text-[0.8125rem] text-[#68717d]">
        <time datetime={post.data.published.toISOString()}>{published}</time>
        <span aria-hidden="true">·</span>
        <span>{post.data.readingTime}</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
